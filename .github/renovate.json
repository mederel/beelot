{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Minor and patch updates, grouped into one pull request, merge once the checks have passed; the merge queue and the ruleset on main enforce them.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Major updates wait for a person.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Keep the Rust toolchain in step with the pins of the CI action.",
      "matchDatasources": [
        "rust-version"
      ],
      "groupName": "rust toolchain"
    }
  ],
  "customManagers": [
    {
      "description": "dtolnay/rust-toolchain is pinned to a commit with its version branch in a comment. The action has no version tags, so the branches are read instead.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/build\\.yml$/"
      ],
      "matchStrings": [
        "dtolnay/rust-toolchain@(?<currentDigest>[0-9a-f]{40}) # (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "dtolnay/rust-toolchain",
      "packageNameTemplate": "https://github.com/dtolnay/rust-toolchain",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "semver"
    }
  ],
  "automergeStrategy": "squash"
}
