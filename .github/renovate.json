{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "A patch update is a fix: the next release is a patch. Grouped, and merged once the checks have passed.",
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "patch updates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "automerge": true
    },
    {
      "description": "A minor update is a feature: the next release is a minor. Grouped, and merged once the checks have passed.",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "minor updates",
      "semanticCommitType": "feat",
      "semanticCommitScope": "deps",
      "automerge": true
    },
    {
      "description": "A major update is a breaking commit (the ! before the colon): the next release is a major. One pull request per dependency, merged by a person.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "semanticCommits": "disabled",
      "commitMessagePrefix": "feat(deps)!:"
    },
    {
      "description": "Keep the Rust toolchain in step with the pins of the CI action.",
      "matchDatasources": [
        "rust-version"
      ],
      "groupName": "rust toolchain"
    }
  ],
  "customManagers": [
    {
      "description": "dtolnay/rust-toolchain is pinned to a commit with its version branch in a comment. The action has no version tags, so the branches are read instead.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/build\\.yml$/"
      ],
      "matchStrings": [
        "dtolnay/rust-toolchain@(?<currentDigest>[0-9a-f]{40}) # (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "dtolnay/rust-toolchain",
      "packageNameTemplate": "https://github.com/dtolnay/rust-toolchain",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "semver"
    }
  ],
  "automergeStrategy": "squash"
}
