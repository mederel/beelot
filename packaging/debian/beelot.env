# Beelot's settings, read by the beelot service (see "Configuration" in
# /usr/share/doc/beelot/README.md). Restart the service after an edit:
#   sudo systemctl restart beelot
# This file holds the database password: keep it readable by root and the
# beelot group only.

# The server listens here; put a reverse proxy in front of it for HTTPS.
BEELOT_BIND=127.0.0.1:8080
# The frontend's files.
BEELOT_STATIC_DIR=/usr/share/beelot/static

# The MariaDB database; create it and its user first (see the README).
#BEELOT_DATABASE_URL=mysql://localhost:3306/beelot
#BEELOT_DATABASE_USERNAME=beelot
#BEELOT_DATABASE_PASSWORD=beelot

# The address players use: the passkeys' relying party.
#BEELOT_PUBLIC_URL=http://localhost:8080
# Take the client address from X-Forwarded-For (only behind a proxy you control).
#BEELOT_TRUST_FORWARDED_HEADERS=false

# The privacy policy's details. The server does not start until all of them are set.
#BEELOT_PRIVACY_CONTROLLER=
#BEELOT_PRIVACY_CONTACT=
#BEELOT_HOSTING_PROVIDER=
#BEELOT_HOSTING_COUNTRY=
#BEELOT_HOSTING_DPA=
#BEELOT_BACKUP_RETENTION_DAYS=
# Required: the key of the IP tokens in the security events (16 characters or more). Keep it secret.
#BEELOT_IP_TOKEN_SECRET=
