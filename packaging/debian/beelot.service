[Unit]
Description=Beelot, a Belote card game server
Documentation=https://github.com/mederel/rubeelot
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=simple
User=beelot
Group=beelot
EnvironmentFile=/etc/beelot/beelot.env
ExecStart=/usr/bin/beelot-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
