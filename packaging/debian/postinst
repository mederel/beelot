#!/bin/sh
set -e

case "$1" in
configure)
    if ! getent passwd beelot >/dev/null; then
        adduser --system --group --no-create-home --home /nonexistent beelot
    fi
    # The settings hold the database password: root and the service only.
    chown root:beelot /etc/beelot/beelot.env
    chmod 0640 /etc/beelot/beelot.env
    # Where beelot-backup writes: backups hold personal data, so root and the service group only.
    install -d -m 0750 -o root -g beelot /var/backups/beelot
    ;;
esac

#DEBHELPER#

exit 0
