# Copy to .env next to compose.yaml and fill in every change-me (https://mederel.github.io/beelot/docs/configuration.html explains each setting).
BEELOT_DATABASE_PASSWORD=change-me
# The address players type: the passkeys' relying party. Never change it once players have signed up.
BEELOT_PUBLIC_URL=http://localhost:8080
# true only behind a reverse proxy that is the sole way in and appends the client's address to X-Forwarded-For.
BEELOT_TRUST_FORWARDED_HEADERS=false
BEELOT_PRIVACY_CONTROLLER=change-me
BEELOT_PRIVACY_CONTACT=change-me@example.org
BEELOT_HOSTING_PROVIDER=change-me
BEELOT_HOSTING_DPA=change-me
# Must match how long your database backups are kept.
BEELOT_BACKUP_RETENTION_DAYS=14
# 16 characters or more, random, secret: openssl rand -hex 32
BEELOT_IP_TOKEN_SECRET=change-me
# A release number, to pin the image instead of following latest.
#BEELOT_VERSION=

# Observability (US-157). Start OpenObserve next to Beelot with: docker compose --profile observability up -d
# Its web interface is then on http://127.0.0.1:5080. The password has 8 to 128 characters, with a lowercase letter, an uppercase letter, a digit and a special character.
#OPENOBSERVE_ROOT_EMAIL=admin@example.org
#OPENOBSERVE_ROOT_PASSWORD=Change-me-1!
# Where the alerts go (US-159). Neither is required; with none set the alerts have no destination. The webhook is any HTTP
# endpoint: Slack, Discord, Mattermost (format json, the default) or an ntfy topic URL (format text).
#OPENOBSERVE_ALERT_WEBHOOK_URL=https://ntfy.sh/your-secret-topic
#OPENOBSERVE_ALERT_WEBHOOK_FORMAT=text
# Set to true if the webhook is on a private address (a ntfy of your own network): OpenObserve refuses those otherwise.
#OPENOBSERVE_ALLOW_PRIVATE_DESTINATIONS=false
# The address you reach the web interface by, for the link in the messages.
#OPENOBSERVE_PUBLIC_URL=http://127.0.0.1:5080
# Alerts by email need the SMTP server of your provider too.
#OPENOBSERVE_ALERT_EMAIL=you@example.org
#OPENOBSERVE_SMTP_ENABLED=true
#OPENOBSERVE_SMTP_HOST=smtp.example.org
#OPENOBSERVE_SMTP_PORT=587
#OPENOBSERVE_SMTP_USER=beelot
#OPENOBSERVE_SMTP_PASSWORD=change-me
#OPENOBSERVE_SMTP_FROM=beelot@example.org
#OPENOBSERVE_SMTP_ENCRYPTION=starttls
# Days the logs, metrics and traces are kept.
#OPENOBSERVE_RETENTION_DAYS=14
# Uncomment both to send Beelot's telemetry to it. The token is: printf '%s' 'EMAIL:PASSWORD' | base64 -w0
#OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20TOKEN
