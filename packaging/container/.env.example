# Copy to .env next to compose.yaml and fill in every change-me (the README explains each setting).
BEELOT_DATABASE_PASSWORD=change-me
# The address players type: the passkeys' relying party. Never change it once players have signed up.
BEELOT_PUBLIC_URL=http://localhost:8080
# true only behind a reverse proxy that is the sole way in and appends the client's address to X-Forwarded-For.
BEELOT_TRUST_FORWARDED_HEADERS=false
BEELOT_PRIVACY_CONTROLLER=change-me
BEELOT_PRIVACY_CONTACT=change-me@example.org
BEELOT_HOSTING_PROVIDER=change-me
BEELOT_HOSTING_DPA=change-me
# Must match how long your database backups are kept.
BEELOT_BACKUP_RETENTION_DAYS=14
# 16 characters or more, random, secret: openssl rand -hex 32
BEELOT_IP_TOKEN_SECRET=change-me
# A release number, to pin the image instead of following latest.
#BEELOT_VERSION=
