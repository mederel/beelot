{
  "$schema": "./web/node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "web/src/**",
      "web/tests/**",
      "web/build/**",
      "web/e2e/**",
      "web/*.ts",
      "web/*.json",
      "frontend-tests/**",
      "!**/*.svelte",
      "!**/*.css",
      "!web/package-lock.json",
      "!frontend-tests/fixtures"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 180 },
  "javascript": { "formatter": { "quoteStyle": "double", "quoteProperties": "preserve", "trailingCommas": "none" } },
  "assist": { "enabled": false },
  "plugins": ["./lint/no-html-sinks.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noDocumentCookie": "off"
      },
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noCommaOperator": "off", "noImportantStyles": "off" }
    }
  }
}
