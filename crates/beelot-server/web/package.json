{
  "name": "beelot-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Beelot's frontend: Svelte 5 and TypeScript, built into ../static (ADR-007).",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check ..",
    "format": "biome format --write ..",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@lucide/svelte": "1.77.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "happy-dom": "21.0.4",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
