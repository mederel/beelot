{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDirs": [
      "..",
      "svelte"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "tsbuildinfo.json",
    "paths": {
      "$lib/*": [
        "../src/lib/*",
        "./svelte/src/lib/*"
      ]
    }
  },
  "files": [
    "../node_modules/svelte-check/dist/src/svelte-shims-v4.d.ts",
    "../node_modules/svelte/svelte-html.d.ts"
  ],
  "include": [
    "../src/**/*.ts",
    "../src/**/*.svelte",
    "../tests/**/*.ts",
    "../build/**/*.ts",
    "../vite.config.ts",
    "svelte/src/**/*.ts",
    "svelte/src/**/*.d.svelte.ts",
    "svelte/tests/**/*.ts",
    "svelte/build/**/*.ts",
    "svelte/vite.config.ts"
  ],
  "exclude": [
    "../src/App.svelte",
    "../src/pages/Crew.svelte",
    "../src/pages/HelpSheet.svelte",
    "../src/pages/Home.svelte",
    "../src/pages/Leaderboard.svelte",
    "../src/pages/Privacy.svelte",
    "../src/pages/ProgressTabs.svelte",
    "../src/pages/Public.svelte",
    "../src/pages/Rules.svelte",
    "../src/pages/Settings.svelte",
    "../src/pages/SetupSheet.svelte",
    "../src/pages/SignInPanel.svelte",
    "../src/pages/Stats.svelte",
    "../src/pages/Tutorial.svelte",
    "../src/shell/Banners.svelte",
    "../src/shell/Nav.svelte",
    "../src/table/AuctionPanel.svelte",
    "../src/table/CoachPanel.svelte",
    "../src/table/Hand.svelte",
    "../src/table/LobbyPanel.svelte",
    "../src/table/MatchEnd.svelte",
    "../src/table/OpenHands.svelte",
    "../src/table/Reactions.svelte",
    "../src/table/RoundResult.svelte",
    "../src/table/RoundReview.svelte",
    "../src/table/Seat.svelte",
    "../src/table/TableHeader.svelte",
    "../src/table/TableView.svelte",
    "../src/table/Trick.svelte",
    "../src/lib/avatars/Avatar.svelte",
    "../src/lib/brand/Bee.svelte",
    "../src/lib/brand/Logo.svelte",
    "../src/lib/cards/CardBack.svelte",
    "../src/lib/cards/PlayingCard.svelte",
    "../src/lib/cards/Suit.svelte",
    "../src/lib/ui/Button.svelte",
    "../src/lib/ui/CodeBoxes.svelte",
    "../src/lib/ui/Segmented.svelte",
    "../src/lib/ui/Sheet.svelte",
    "../src/lib/ui/SuitText.svelte",
    "../src/lib/ui/Switch.svelte"
  ]
}